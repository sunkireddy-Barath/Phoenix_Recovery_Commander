# Dependencies — never commit installed packages or lock files
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/.pnpm-lock.yaml

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Build outputs
frontend/dist/
frontend/dist-ssr/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
